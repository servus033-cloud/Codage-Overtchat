{
    "start": {
        "version": "1.0.0"
    },
    "Overtchat": {
        "bootstrap": [
            "overtchat-setup"
        ],
        "builder": [
            "builder.json",
            "MAKEFILE",
            "build.sh",
            "control_package.sh",
            "encrypt.sh",
            "package.sh"
        ],
        "components": {
            "server": {
                "bin": [
                    "start.sh"
                ],
                "conf": [
                    "server.json"
                ],
                "lib": [
                    "install.sh",
                    "uninstall.sh"
                ]
            },
            "service": {
                "bin": [
                    "start.sh"
                ],
                "conf": [
                    "service.json"
                ],
                "lib": [
                    "install.sh",
                    "uninstall.sh",
                    "logo.sh"
                ]
            }
        },
        "config": [
            "config-base.json",
            "config.json",
            "defaults.json",
            "irix.json",
            "paths.json",
            "schema.json"
        ],
        "installer": [
            "config.sh",
            "install.sh",
            "installirix",
            "preflight.sh",
            "repair.sh",
            "state.sh",
            "status.sh",
            "ui.sh",
            "uninstall.sh",
            "update.sh"
        ],
        "runtime": {
            "files": [
                "cmds_irix.json",
                "state.json",
                "version.json"
            ],
            "logs": []
        }
    },
    "git": {
        "enabled": true,
        "brutegit": "https://raw.githubusercontent.com",
        "repository": "https://github.com/Servus33/Overtchat.git",
        "depot": "/tmp/.Overtchat",
        "owner": "Servus33",
        "repo": "Overtchat",
        "branch": "main"
    }
}
