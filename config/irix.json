{
    "irix": {
        "version": "0.1.0",
        "enabled": true
    },

    "engine": {
        "name": "IriX",
        "mode": "stable",
        "logLevel": "info",
        "strict": true,
        "failFast": true,
        "dryRun": false,
        "interactive": true
    },

    "features": {
        "builder": true,
        "runtime": true,
        "gitFallback": true,
        "autoInit": true,
        "gitBootstrap": true,
        "autoRepair": true,
        "selfUpdate": false
    },

    "execution": {
        "defaultMode": "install",
        "allowedModes": [
            "install",
            "uninstall",
            "update",
            "init",
            "control",
            "status"
        ],
        "requireConfirmation": [
            "install",
            "uninstall"
        ]
    },

    "validation": {
        "config": true,
        "schema": true,
        "paths": true,
        "scripts": true,
        "runtime": true
    },

    "timeouts": {
        "global": 300,
        "git": 120,
        "script": 180
    },

    "ui": {
        "colors": true,
        "icons": true,
        "progress": true,
        "verbosity": "normal"
    },

    "logging": {
        "enabled": true,
        "level": "info",
        "rotate": true,
        "maxSizeMB": 5,
        "keepFiles": 5
    },

    "security": {
        "lockExecution": true,
        "checkRoot": true,
        "sanitizeEnv": true,
        "allowRoot": false,
        "requireJq": true,
        "allowedUsers": []
    },

    "debug": {
        "enabled": false,
        "trace": false,
        "dumpConfig": false
    }
}
