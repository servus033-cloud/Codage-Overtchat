#!/usr/bin/env bash
###############################################################################
# OVERTCHAT SETUP – IriX Engine (clean & hardened)
###############################################################################

[[ "${1:-}" == "--debug" ]] && set -x
set -euo pipefail
export PS4='+ [${BASH_SOURCE}:${LINENO}] '

IFS=$'\n'

###############################################################################
# Globals
###############################################################################

OS="$(uname)"
USER_ID="$(id -u)"

DRY_RUN=false

DATA="$HOME/Overtchat"
default_file="$DATA/config/config-base.json"

###############################################################################
# UI helpers
###############################################################################

valid()   { echo -e "\033[1;32mVALIDE\033[0m $*"; }
info()    { echo -e "\033[1;34mINFO\033[0m $*"; }
warning() { echo -e "\033[1;33mALERTE\033[0m $*"; }
error()   { echo -e "\033[1;31mERREUR\033[0m $*"; }

###############################################################################
# Guards
###############################################################################

[[ "$OS" != "Linux" ]] && { error "Système non supporté"; exit 1; }
[[ "$USER_ID" -eq 0 ]] && { error "Ne pas exécuter en root"; exit 1; }

###############################################################################
# Dependencies
###############################################################################

command -v jq >/dev/null 2>&1 || {
    warning "jq manquant – installation"
    sudo apt-get update && sudo apt-get install -y jq
    valid "jq installé"
}

###############################################################################
# Git raw download
###############################################################################

download_from_github() {
    local folders="$1"
    local files="$2"

    local owner repo branch brute
    owner="$(jq -r '.git.owner' "$default_file")"
    repo="$(jq -r '.git.repo' "$default_file")"
    branch="$(jq -r '.git.branch' "$default_file")"
    http="$(jq -r '.git.brutegit' "$default_file")"

    info "Download > $folders → $files"

    curl -fsSL \
   # https://raw.githubusercontent.com/Servus33/Overtchat/main/builder/builder.json
      "$http/$owner/$repo/$branch/$folders/$files" \
      -o "$files" || {
        error "Échec du téléchargement de < $files >"
        exit 1
      }
}

###############################################################################
# Welcome
###############################################################################

cat <<'EOF'
Bienvenue sur le programme Service-Overtchat by SerVuS
EOF

###############################################################################
# Bootstrap config-base.json
###############################################################################

init_config() {
    if [[ ! -f "$default_file" ]]; then
        read -rp "Vous installez Service-Overtchat. Voulez-vous continuer ? [Y/N] : " rep
        [[ "$rep" =~ ^[Yy]$ ]] || exit 0

        ! mkdir -p "$DATA/config" >/dev/null
        info "Téléchargement de < $(basename -- "$default_file") >"

        curl -fsSL \
        https://raw.githubusercontent.com/Servus33/Overtchat/main/config/$(basename -- "$default_file") \
        -o "$default_file" || {
            error "Échec du téléchargement de < $(basename -- "$default_file") >"
            return 1
        }
    fi

    jq -e 'type=="object"' "$default_file" >/dev/null || {
        error "$(basename -- "$default_file") invalide"
        return 1
    }
}

init_config || exit 1
jq empty "$default_file" || exit 1

###############################################################################
# Base folders & files
###############################################################################

fetch_file() {
    local url="$1"
    local dest="$2"
    echo "1> $url"
    echo "2> $dest"

    if [[ -f "$HOME/$dest" ]]; then
        warning "$dest"
        return 0
    fi

    if curl -fsSL "$url" -o "$dest"; then
        info "$dest"
    else
        error "$dest (créé vide)"
        touch "$dest"
    fi
}

create_tree() {
    local base_path="$1"
    local json_path="$2"
    local repo_path="$3"

    local repo
    repo="$(jq -r '.git.brutegit' "$default_file")"
    branch="$(jq -r '.git.branch' "$default_file")"

    # ARRAY = fichiers
    if jq -e "$json_path | type == \"array\"" "$default_file" >/dev/null; then
        mapfile -t files < <(jq -r "$json_path[]" "$default_file")
        for file in "${files[@]}"; do
            local dest="$base_path/$file"
            local url="$repo/$repo_path/$file"
            fetch_file "$url" "$dest"
        done
        return 0
    fi

    # OBJECT = dossiers
    if jq -e "$json_path | type == \"object\"" "$default_file" >/dev/null; then
        mapfile -t keys < <(jq -r "$json_path | keys[]" "$default_file")
        for key in "${keys[@]}"; do
            local dir="$base_path/$key"
            mkdir -p "$dir"
            valid "$dir"
            create_tree "$dir" "$json_path[\"$key\"]" "$repo_path/$key"
        done
    fi
}

create_tree "Overtchat" ".Overtchat" "Overtchat/main"

find Overtchat -type f -name "*.sh" -exec chmod +x {} \;

###############################################################################
# Merge config
###############################################################################

CONFIG_DIR="$DATA/config"
for f in config-base.json config.json defaults.json irix.json paths.json schema.json; do
    [[ -f "$CONFIG_DIR/$f" ]] || echo '{}' >"$CONFIG_DIR/$f"
done

# Merge safe
MERGED_CONFIG=$(jq -s 'map(. // {}) | add' \
    "$CONFIG_DIR/config-base.json" \
    "$CONFIG_DIR/config.json")

# Vérifier que c'est bien un objet
jq -e 'type=="object"' <<<"$MERGED_CONFIG" >/dev/null || exit 1

###############################################################################
# Git bootstrap
###############################################################################

git_init() {
    if [[ "$(jq -r '.git.enabled' <<<"$MERGED_CONFIG")" == "true" ]] &&
       [[ "$(jq -r '.git.mode' <<<"$MERGED_CONFIG")" == "dev" ]]; then

        repo="$(jq -r '.git.repository' <<<"$MERGED_CONFIG")"
        branch="$(jq -r '.git.branch' <<<"$MERGED_CONFIG")"
        depot="$(jq -r '.git.depot' <<<"$MERGED_CONFIG")"

        [[ -d "$depot/.git" ]] || {
            warning "Clone Git (mode dev) : $repo"
            git clone --depth 1 -b "$branch" "$repo" "$depot"
        }
    fi
}

###############################################################################
# Runtime state
###############################################################################

STATE_JSON="$DATA/runtime/state.json"

# Créer le fichier state.json si absent
if [[ ! -f "$STATE_JSON" ]]; then
  cat >"$STATE_JSON" <<EOF
{
  "status":"idle",
  "lastAction":null,
  "lastRun":null,
  "errors":{"count":0,"last":null}
}
EOF
fi

###############################################################################
# Logo
###############################################################################


if [[ -f "bash Overtchat/components/service/lib/logo.sh" ]]; then
    bash "bash Overtchat/components/service/lib/logo.sh"
else
    warning "logo.sh introuvable ou non exécutable"
fi

###############################################################################
# Menu
###############################################################################

while true; do
cat <<EOF
            Bienvenue sur le panel Service-Overtchat by SerVuS - Choisissez un numéro ci-dessous pour intéragir avec le programme.

                1) Quitter      2) Control      3) Install      4) Uninstall      5) Init      6) Update      7) Status

Détail des Options :
    1 - Permet de quitter le programme
    2 - Permet de scanner l'ensemble du programme pour voir sa compatibilité
    3 - Installation des divers options proposé par Service-Overtchat
    4 - Permet de désinstaller divers option sur Service-Overtchat
    5 - Permet de re-initialisé la configuration par défaut de l'ensemble du programme
    6 - Permet d'effectuer la mise à jour de l'ensemble du programme Service-Overtchat avec ses divers programmes inclus
    7 - Permet de voir les services < installé / actif / anomalies >

EOF

read -rp "Votre choix : " c
case "$c" in
  1) exit 0 ;;
  2) run_action control ;;
  3) run_action install ;;
  4) run_action uninstall ;;
  5) run_action init ;;
  6) run_action update ;;
  7) run_action status ;;
  *) warning "Choix invalide" ;;
esac
done
