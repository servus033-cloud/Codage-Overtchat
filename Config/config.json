{
    "project": {
        "name": "Service-Overtchat",
        "version": "0.1.0",
        "environment": "dev"
    },
    "paths": {
        "base": "/opt/service-overtchat",
        "scripts": {
            "install": "scripts/install.sh",
            "uninstall": "scripts/uninstall.sh",
            "update": "scripts/update.sh",
            "control": "scripts/control_package.sh"
        },
        "config": "config"
    },
    "git": {
        "enabled": true,
        "depot": "/tmp/.Overtchat",
        "repository": "https://github.com/Servus33/Overtchat",
        "branch": "main",
        "autoUpdate": false
    },
    "modes": {
        "install": true,
        "uninstall": true,
        "update": true,
        "init": true
    },
    "logging": {
        "enabled": true,
        "level": "info",
        "file": "/var/log/service-overtchat.log"
    },
    "security": {
        "requireRoot": true,
        "allowRemoteDownload": true
    }
}
