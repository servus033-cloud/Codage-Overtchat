{
    "start": {
        "version": "1.0.0"
    },
    "Overtchat": {
        "Bootstrap": [
            "overtchat-setup"
        ],
        "Builder": [
            "builder.json",
            "MAKEFILE",
            "build.sh",
            "control_package.sh",
            "encrypt.sh",
            "package.sh"
        ],
        "Components": {
            "Serveur": {
                "bin": [
                    "start.sh"
                ],
                "conf": [
                    "server.json"
                ],
                "lib": [
                    "install.sh",
                    "uninstall.sh"
                ]
            },
            "Service": {
                "bin": [
                    "start.sh"
                ],
                "conf": [
                    "service.json"
                ],
                "lib": [
                    "install.sh",
                    "uninstall.sh",
                    "logo.sh"
                ]
            }
        },
        "Config": [
            "config-base.json",
            "config.json",
            "defaults.json",
            "irix.json",
            "paths.json",
            "schema.json"
        ],
        "Installer": [
            "config.sh",
            "install.sh",
            "installirix.sh",
            "preflight.sh",
            "repair.sh",
            "state.sh",
            "status.sh",
            "ui.sh",
            "uninstall.sh",
            "update.sh"
        ],
        "Runtime": [
            "cmds_irix.json",
            "state.json",
            "version.json"
        ],
        "Runtime/Logs": []
    },
    "git": {
        "enabled": true,
        "brutegit": "https://raw.githubusercontent.com/Servus33",
        "repository": "https://github.com/SerVuS33/Overtchat.git",
        "depot": "/tmp/.Overtchat",
        "owner": "SerVuS33",
        "repo": "Overtchat",
        "branch": "main"
    }
}
