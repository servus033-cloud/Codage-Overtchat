#!/usr/bin/env bash
###############################################################################
# OVERTCHAT SETUP – IriX Engine (clean & hardened)
###############################################################################

[[ "${1:-}" == "--debug" ]] && set -x
set -euo pipefail
export PS4='+ [${BASH_SOURCE}:${LINENO}] '

###############################################################################
# Globals
###############################################################################

OS="$(uname)"
USER_ID="$(id -u)"

DATA="$HOME/Overtchat"
default_file="$DATA/config/config-base.json"

###############################################################################
# UI helpers
###############################################################################

valid()   { echo -e "\033[1;32m$*\033[0m"; }
info()    { echo -e "\033[1;34m$*\033[0m"; }
warning() { echo -e "\033[1;33m$*\033[0m"; }
error()   { echo -e "\033[1;31m$*\033[0m"; }

###############################################################################
# Guards
###############################################################################

[[ "$OS" != "Linux" ]] && { error "Système non supporté"; exit 1; }
[[ "$USER_ID" -eq 0 ]] && { error "Ne pas exécuter en root"; exit 1; }

###############################################################################
# Dependencies
###############################################################################

command -v jq >/dev/null 2>&1 || {
    warning "jq manquant – installation"
    sudo apt-get update && sudo apt-get install -y jq
    valid "jq installé"
}

###############################################################################
# Welcome
###############################################################################

cat <<'EOF'
Bienvenue sur le programme Service-Overtchat by SerVuS
EOF

###############################################################################
# Bootstrap config-base.json
###############################################################################

if [[ ! -f "$default_file" ]]; then
    read -rp "Vous installez Service-Overtchat. Voulez-vous continuer ? [Y/N] : " rep
    [[ "$rep" =~ ^[Yy]$ ]] || exit 0

    ! mkdir -p "$DATA/config" >/dev/null
    info "Téléchargement de < $(basename -- "$default_file") >"

    curl -fsSL \
      https://raw.githubusercontent.com/Servus33/Overtchat/main/config/$(basename -- "$default_file") \
      -o "$default_file" || {
        error "Échec du téléchargement de < $(basename -- "$default_file") >"
        exit 1
      }
fi

jq -e 'type=="object"' "$default_file" >/dev/null || {
    error "$(basename -- "$default_file") invalide"
    exit 1
}

###############################################################################
# Base dirs
###############################################################################

BASE_DIR="$HOME/$(jq -r '.folders.home' "$default_file")"
if [[ -z "$BASE_DIR" ]]; then
    error "La valeur 'home' dans le fichier $(basename -- "$default_file") est vide"; exit 1
fi

info "Load Home > $BASE_DIR"

###############################################################################
# Git raw download
###############################################################################

download_from_github() {
    local repo_path="$1"
    local local_path="$2"

    local owner repo branch brute
    owner="$(jq -r '.git.owner' "$default_file")"
    repo="$(jq -r '.git.repo' "$default_file")"
    branch="$(jq -r '.git.branch' "$default_file")"
    brute="$(jq -r '.git.brutegit' "$default_file")"

    [[ "$repo_path" == Overtchat/* ]] && {
        error "Chemin Git invalide : $repo_path"
        return 1
    }

    mkdir -p "$(dirname "$local_path")"
    info "Download > $repo_path → $local_path"

    curl -fSL \
      "$brute/$owner/$repo/$branch/$repo_path" \
      -o "$local_path"
}

###############################################################################
# Create folders
###############################################################################

jq -r '.folders[] | select(length>0)' "$default_file" | while read -r dir; do
  ! mkdir -p "$BASE_DIR/$dir" >/dev/null
done

###############################################################################
# JSON validation
###############################################################################

validate_json() {
    [[ -f "$1" ]] && [[ -s "$1" ]] && jq -e 'type=="object"' "$1" >/dev/null
}

###############################################################################
# Create & load JSON files
###############################################################################

info "Create & Load Files Json"

jq -r '.json[]' "$default_file" | while read -r repo_path; do
    local_path="$BASE_DIR/$repo_path"

    if validate_json "$local_path"; then
        continue
    fi

    error "JSON manquant ou invalide : $repo_path"

    if ! download_from_github "$repo_path" "$local_path"; then
        warning "Fallback JSON vide : $local_path"
        echo '{}' >"$local_path"
    fi

    validate_json "$local_path" || {
        error "JSON corrompu : $local_path"
        exit 1
    }
done

###############################################################################
# Merge config
###############################################################################

DEFAULTS_JSON="$BASE_DIR/$(jq -r '.json.defaults' "$default_file")"
CONFIG_JSON="$BASE_DIR/$(jq -r '.json.config' "$default_file")"

[[ -f "$CONFIG_JSON" ]] || echo '{}' >"$CONFIG_JSON"

MERGED_CONFIG="$(jq -s '.[0] * .[1]' "$DEFAULTS_JSON" "$CONFIG_JSON")"
jq -e 'type=="object"' <<<"$MERGED_CONFIG" >/dev/null || exit 1

###############################################################################
# Git bootstrap
###############################################################################

if [[ "$(jq -r '.git.enabled' <<<"$MERGED_CONFIG")" == "true" ]]; then
    repo="$(jq -r '.git.repository' <<<"$MERGED_CONFIG")"
    branch="$(jq -r '.git.branch' <<<"$MERGED_CONFIG")"
    depot="$(jq -r '.git.depot' <<<"$MERGED_CONFIG")"

    [[ -d "$depot/.git" ]] || {
        warning "Clone Git $repo"
        git clone --depth 1 -b "$branch" "$repo" "$depot"
    }
fi

###############################################################################
# Runtime state
###############################################################################

STATE_JSON="$BASE_DIR/$(jq -r '.json.state' "$default_file")"
[[ -f "$STATE_JSON" ]] || cat >"$STATE_JSON" <<EOF
{ "status":"idle","lastAction":null,"lastRun":null,"errors":{"count":0,"last":null} }
EOF

###############################################################################
# Script resolver & runner
###############################################################################

resolve_script() {
    local name="$1"
    local paths="$BASE_DIR/$(jq -r '.json.paths' "$default_file")"
    local rel

    rel="$(jq -r ".scripts.$name // empty" "$paths")"
    [[ -n "$rel" && -f "$BASE_DIR/$rel" ]] || return 1
    chmod +x "$BASE_DIR/$rel" 2>/dev/null || true
    echo "$BASE_DIR/$rel"
}

run_action() {
    script="$(resolve_script "$1")" || { error "Script introuvable"; return 1; }
    info "Exécution : $1"
    bash "$script"
}

###############################################################################
# Logo
###############################################################################
logo=$BASE_DIR/$(jq -r '.start.logo' "$default_file")

if [[ ! -f "$logo" ]]; then
    info "Téléchargement du Logo"
    curl -fsSL \
      https://raw.githubusercontent.com/Servus33/Overtchat/main/components/service/lib/$(basename -- "$logo") \
      -o "$(basename -- "$logo")" || {
        error "Échec du téléchargement du Logo"
      }
fi

clear
[[ -f "$logo" ]] && bash $logo

###############################################################################
# Menu
###############################################################################

while true; do
cat <<EOF
            Bienvenue sur le panel Service-Overtchat by SerVuS - Choisissez un numéro ci-dessous pour intéragir avec le programme.

                1) Quitter      2) Control      3) Install      4) Uninstall      5) Init      6) Update      7) Status

Détail des Options :
    1 - Permet de quitter le programme
    2 - Permet de scanner l'ensemble du programme pour voir sa compatibilité
    3 - Installation des divers options proposé par Service-Overtchat
    4 - Permet de désinstaller divers option sur Service-Overtchat
    5 - Permet de re-initialisé la configuration par défaut de l'ensemble du programme
    6 - Permet d'effectuer la mise à jour de l'ensemble du programme Service-Overtchat avec ses divers programmes inclus
    7 - Permet de voir les services < installé / actif / anomalies >

EOF
read -rp "Votre choix : " c
case "$c" in
  1) exit 0 ;;
  2) run_action control ;;
  3) run_action install ;;
  4) run_action uninstall ;;
  5) run_action init ;;
  6) run_action update ;;
  7) run_action status ;;
  *) warning "Choix invalide" ;;
esac
done
